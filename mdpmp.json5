{
    "common": {
        "packVersion": "1.0.0",
        "packName": "GTX",
        "forge": "47.4.20",
        "minecraft": "1.20.1",
        "configs": "overrides/"
    },

    "curseforge": {
        "minecraft": {
            "version": "{minecraft}",
            "modLoaders": [
                {
                    "id": "forge-{forge}",
                    "primary": true
                }
            ]
        },
        "manifestType": "minecraftModpack",
        "manifestVersion": 1,
        "name": "{packName}",
        "version": "{packVersion}",
        "author": "anonymousey",
        "overrides": "overrides",
        "image": "https://media.forgecdn.net/avatars/1528/463/638992654541391725.png"
    },

    "modrinth": {
        "game": "minecraft",
        "formatVersion": 1,
        "versionId": "{packVersion}",
        "name": "{packName}",
        "summary": "GTX VCS Test",
        "dependencies": {
            "forge": "{forge}",
            "minecraft": "{minecraft}"
        }
    },

